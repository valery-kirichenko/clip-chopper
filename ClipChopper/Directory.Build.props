<Project>

  <!-- Project properties -->
  <PropertyGroup>
    <AppPlatforms>x64</AppPlatforms>
    <AppConfigurations>Debug;Release</AppConfigurations>
    <DotNetTargetFramework>net10.0</DotNetTargetFramework>
    <AppTargetFramework>$(DotNetTargetFramework)</AppTargetFramework>
    <WindowsAppTargetFramework>$(DotNetTargetFramework)-windows</WindowsAppTargetFramework>
    <WinUIAppTargetFramework>$(DotNetTargetFramework)-windows10.0.22621.0</WinUIAppTargetFramework>
    <WinUIAppTargetPlatformMinVersion>10.0.17763.0</WinUIAppTargetPlatformMinVersion>
    <LibraryTargetFramework>$(DotNetTargetFramework)</LibraryTargetFramework>
    <TestTargetFramework>$(DotNetTargetFramework)</TestTargetFramework>
    <CSharpLangVersion>10.0</CSharpLangVersion>
    <UiTestTargetFramework>$(DotNetTargetFramework)-windows</UiTestTargetFramework>
  </PropertyGroup>

  <!-- NuGet packages -->
  <PropertyGroup>
    <AcolyteNETPackageVersion>2.2.0</AcolyteNETPackageVersion>
    <FFMEWindowsPackageVersion>4.4.350</FFMEWindowsPackageVersion>
    <NExifToolPackageVersion>0.11.0</NExifToolPackageVersion>
    <MicrosoftExtensionsConfigurationPackageVersion>10.0.12</MicrosoftExtensionsConfigurationPackageVersion>
    <MicrosoftExtensionsConfigurationBinderPackageVersion>10.0.12</MicrosoftExtensionsConfigurationBinderPackageVersion>
    <MicrosoftExtensionsConfigurationJsonPackageVersion>10.0.12</MicrosoftExtensionsConfigurationJsonPackageVersion>
    <FlaUICorePackageVersion>5.0.0</FlaUICorePackageVersion>
    <FlaUIUIA3PackageVersion>5.0.0</FlaUIUIA3PackageVersion>
    <MicrosoftNETTestSdkPackageVersion>18.11.0</MicrosoftNETTestSdkPackageVersion>
    <MinVerPackageVersion>3.1.0</MinVerPackageVersion>
    <NewtonsoftJsonPackageVersion>13.0.1</NewtonsoftJsonPackageVersion>
    <NLogPackageVersion>4.7.15</NLogPackageVersion>
    <NLogConfigPackageVersion>4.7.15</NLogConfigPackageVersion>
    <NLogSchemaPackageVersion>4.7.15</NLogSchemaPackageVersion>
    <OokiiDialogsWpfPackageVersion>5.0.1</OokiiDialogsWpfPackageVersion>
    <XunitPackageVersion>2.9.3</XunitPackageVersion>
    <XunitRunnerVisualStudioPackageVersion>3.1.5</XunitRunnerVisualStudioPackageVersion>
  </PropertyGroup>

</Project>
