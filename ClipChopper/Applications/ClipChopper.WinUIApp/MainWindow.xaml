<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClipChopper.WinUIApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClipChopper.WinUIApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:flyleaf="using:FlyleafLib.Controls.WinUI"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop x:Name="MicaBackdrop"/>
    </Window.SystemBackdrop>

    <Grid AllowDrop="True" Drop="Grid_Drop" DragOver="Grid_DragOver" KeyDown="Grid_KeyDown" KeyUp="Grid_KeyUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" x:Name="AppTitleBar" IsHitTestVisible="True">
            <Image Source="Assets/icon.ico"
                   HorizontalAlignment="Left" 
                   Width="16" Height="16" 
                   Margin="8,0"/>
            <TextBlock x:Name="AppTitleTextBlock" Text="ClipChopper"
                   TextWrapping="NoWrap"
                   Style="{StaticResource CaptionTextBlockStyle}" 
                   VerticalAlignment="Center"
                   Margin="28,0,0,0"/>
        </Grid>

        <Grid x:Name="RootGrid" Grid.Row="1">
            <Grid.Resources>
                <flyleaf:TicksToTimeConverter x:Key="TicksToTime"/>
                <flyleaf:TicksToMilliSecondsConverter x:Key="TicksToMilliSeconds"/>
                <local:IntToBooleanConverter x:Key="IntToBooleanConverter"/>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Center" AllowFocusOnInteraction="False">
                    <CommandBar.Resources>
                        <ResourceDictionary>
                            <StaticResource x:Key="CommandBarBackgroundOpen" ResourceKey="ControlFillColorTransparentBrush"/>

                            <Style TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                                <Setter Property="IsTabStop" Value="False"/>
                            </Style>
                        </ResourceDictionary>
                    </CommandBar.Resources>
                    <AppBarButton ToolTipService.ToolTip="Open Folder" Label="Open Folder" LabelPosition="Collapsed" Click="OpenFolderButton_Click">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Folder"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Icon="Refresh" ToolTipService.ToolTip="Refresh" Label="Refresh" LabelPosition="Collapsed" Click="RefreshButton_Click"/>
                    <AppBarButton Icon="Sort" ToolTipService.ToolTip="Sort" Label="Sort" LabelPosition="Collapsed">
                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <RadioMenuFlyoutItem Text="Name" GroupName="SortAttributeGroup" IsChecked="{Binding NameSortProperty, Mode=TwoWay}"/>
                                <RadioMenuFlyoutItem Text="Date" GroupName="SortAttributeGroup" IsChecked="{Binding DateSortProperty, Mode=TwoWay}"/>
                                <RadioMenuFlyoutItem Text="Size" GroupName="SortAttributeGroup" IsChecked="{Binding SizeSortProperty, Mode=TwoWay}"/>
                                <MenuFlyoutSeparator/>
                                <RadioMenuFlyoutItem Text="Ascending" GroupName="SortKindGroup" IsChecked="{Binding AscendingSortProperty, Mode=TwoWay}"/>
                                <RadioMenuFlyoutItem Text="Descending" GroupName="SortKindGroup" IsChecked="{Binding DescendingSortProperty, Mode=TwoWay}"/>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <CommandBar.SecondaryCommands>
                        <AppBarElementContainer>
                            <CheckBox Margin="12 0" x:Name="PreciseSeeking" Content="Precise Seeking" IsChecked="{Binding Player.Config.Player.SeekAccurate, Mode=TwoWay}"/>
                        </AppBarElementContainer>
                        <AppBarElementContainer>
                            <CheckBox Margin="12 0" x:Name="MicaKind" Checked="MicaKind_IsCheckedChanged" Unchecked="MicaKind_IsCheckedChanged" Content="Mica Alt"/>
                        </AppBarElementContainer>
                    </CommandBar.SecondaryCommands>
                </CommandBar>

                <ListView Grid.Row="1" x:Name="DirectoryList" IsTabStop="False" SelectionChanged="DirectoryList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" CanDragItems="True" DragItemsStarting="DirectoryList_DragItemsStarting" DragItemsCompleted="DirectoryList_DragItemsCompleted">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock IsTabStop="False" Text="{Binding Name}" Padding="0,4" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="IsTabStop" Value="False"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>

            <controls:GridSplitter x:Name="GridSplitter" Grid.Column="1" MinWidth="8" HorizontalAlignment="Stretch" IsTabStop="False" Background="#11808080">
                <controls:GridSplitter.Resources>
                    <ResourceDictionary>
                        <SolidColorBrush x:Key="SystemControlSplitterPointerOver" Color="#33808080"/>
                        <SolidColorBrush x:Key="SystemControlSplitterPressed" Color="#66808080"/>
                    </ResourceDictionary>
                </controls:GridSplitter.Resources>
            </controls:GridSplitter>

            <Grid Grid.Column="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <flyleaf:FlyleafHost x:Name="FlyleafHost" Player="{Binding Player}" KeyBindings="False" Grid.Row="0" PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved" SizeChanged="FlyleafHost_SizeChanged">
                    <Canvas x:Name="SelectionCanvas" PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved">
                        <Rectangle x:Name="SelectionRectangle" StrokeThickness="1" Stroke="LightBlue"  Fill="#220000FF" Visibility="Collapsed"/>
                    </Canvas>
                </flyleaf:FlyleafHost>

                <Grid Grid.Row="1" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Margin="8,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <!--Current Time | Slider | Duration-->
                        <TextBlock Grid.Column="0"
                                   HorizontalAlignment="Left" 
                                   VerticalAlignment="Center"
                                   Text="{Binding Player.CurTime, Converter={StaticResource TicksToTime}}"/>
                        <Grid Grid.Column="1" Margin="10,0,10,0">
                            <Rectangle x:Name="FragmentRangeBackground" SizeChanged="FragmentRangeBackground_SizeChanged" Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" Height="4" RadiusX="2" RadiusY="2" Grid.Row="0"/>
                            <Rectangle x:Name="FragmentRange" Fill="{ThemeResource AccentFillColorDefaultBrush}" Height="4" RadiusX="2" RadiusY="2" Grid.Row="0" HorizontalAlignment="Left" />
                            <Slider IsTabStop="False"
                                VerticalAlignment="Center"
                                IsThumbToolTipEnabled="False"
                                IsEnabled="{Binding Player.CanPlay, Mode=OneWay}"
                                Value="{Binding Player.CurTime, Mode=TwoWay, Converter={StaticResource TicksToMilliSeconds}}" 
                                Maximum="{Binding Player.Duration, Converter={StaticResource TicksToMilliSeconds}}">
                                <Slider.Resources>
                                    <ResourceDictionary>
                                        <StaticResource x:Key="SliderTrackFill" ResourceKey="ControlFillColorTransparentBrush"/>
                                        <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="ControlFillColorTransparentBrush"/>
                                        <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="ControlFillColorTransparentBrush"/>
                                        <StaticResource x:Key="SliderTrackFillDisabled" ResourceKey="ControlFillColorTransparentBrush"/>
                                        <StaticResource x:Key="SliderTrackValueFill" ResourceKey="ControlFillColorTransparentBrush"/>
                                        <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="ControlFillColorTransparentBrush"/>
                                        <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="ControlFillColorTransparentBrush"/>
                                        <StaticResource x:Key="SliderTrackValueFillDisabled" ResourceKey="ControlFillColorTransparentBrush"/>
                                    </ResourceDictionary>
                                </Slider.Resources>
                            </Slider>
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Text="{Binding Player.Duration, Converter={StaticResource TicksToTime}}"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="4">

                            <Button x:Name="PlayButton" ToolTipService.ToolTip="Play/Pause (Space, K)" IsTabStop="False" Command="{Binding Player.Commands.TogglePlayPause}" IsEnabled="{Binding Player.CanPlay, Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Space"/>
                                    <KeyboardAccelerator Key="K"/>
                                </Button.KeyboardAccelerators>
                                <SymbolIcon Symbol="Play" />
                            </Button>
                            <Button x:Name="SeekBackwardButton" ToolTipService.ToolTip="Seek Backward (Left, J)" IsTabStop="False" Command="{Binding Player.Commands.SeekBackward}" IsEnabled="{Binding Player.CanPlay, Mode=OneWay}" Margin="4 0 0 0" RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <ScaleTransform ScaleX="-1"/>
                                </Button.RenderTransform>
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Left"/>
                                    <KeyboardAccelerator Key="J"/>
                                </Button.KeyboardAccelerators>
                                <FontIcon Glyph="&#xE847;" />
                            </Button>
                            <Button x:Name="SeekFrameBackwardButton" ToolTipService.ToolTip="Step Backward (Ctrl+Left, Comma)" IsTabStop="False" Click="SeekFrameBackwardButton_Click"  IsEnabled="{Binding Player.CanPlay, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <ScaleTransform ScaleX="-1"/>
                                </Button.RenderTransform>
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Left" Modifiers="Control"/>
                                </Button.KeyboardAccelerators>
                                <FontIcon Glyph="&#xE846;" />
                            </Button>
                            <Button x:Name="SeekFrameForwardButton" ToolTipService.ToolTip="Step Forward (Ctrl+Right, Period)" IsTabStop="False" Command="{Binding Player.Commands.ShowFrameNext}" IsEnabled="{Binding Player.CanPlay, Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Right" Modifiers="Control"/>
                                </Button.KeyboardAccelerators>
                                <FontIcon Glyph="&#xE846;" />
                            </Button>
                            <Button x:Name="SeekForwardButton" ToolTipService.ToolTip="Seek Forward (Right, L)" IsTabStop="False" Command="{Binding Player.Commands.SeekForward}" IsEnabled="{Binding Player.CanPlay, Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Right"/>
                                    <KeyboardAccelerator Key="L"/>
                                </Button.KeyboardAccelerators>
                                <FontIcon Glyph="&#xE847;" />
                            </Button>
                            <Button x:Name="StartFragmentButton" Click="StartFragmentButton_Click" IsTabStop="False" IsEnabled="{Binding Player.CanPlay, Mode=OneWay}" Margin="4,0,0,0">
                                <FontIcon Glyph="&#xE819;" />
                            </Button>
                            <Button x:Name="EndFragmentButton" Click="EndFragmentButton_Click" IsTabStop="False" IsEnabled="{Binding Player.CanPlay, Mode=OneWay}">
                                <FontIcon Glyph="&#xE81A;" />
                            </Button>

                            <ToggleButton x:Name="CropButton" Click="CropButton_Click" Margin="4,0,0,0" IsTabStop="False" IsEnabled="{Binding Player.CanPlay, Mode=OneWay}">
                                <FontIcon Glyph="&#xE7A8;" />
                            </ToggleButton>
                            <Button x:Name="TakeSnapshotButton" Click="TakeSnapshotButton_Click" ToolTipService.ToolTip="Save Current Frame (Ctrl+Alt+S)" IsTabStop="False" IsEnabled="{Binding Player.CanPlay, Mode=OneWay}" Margin="4,0,0,0">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="S" Modifiers="Control,Menu"/>
                                </Button.KeyboardAccelerators>
                                <SymbolIcon Symbol="Camera"/>
                            </Button>

                            <Button x:Name="SaveButton" ToolTipService.ToolTip="Save Trimmed Video (Ctrl+S)" Click="SaveButton_Click" IsTabStop="False" IsEnabled="{Binding Player.CanPlay, Mode=OneWay}" CornerRadius="4,0,0,4">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="S" Modifiers="Control"/>
                                </Button.KeyboardAccelerators>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE792;" />
                                    <TextBlock Text="Save..."/>
                                </StackPanel>
                            </Button>
                            <Button IsTabStop="False" CornerRadius="0,4,4,0" Margin="-4,0,0,0" VerticalAlignment="Stretch">
                                <FontIcon Glyph="&#xE70D;" FontSize="11" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Click="AdvancedSave_Click">Advanced...</MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <ComboBox x:Name="AudioTrackSelector" MinWidth="160" IsTabStop="False" ItemsSource="{x:Bind AudioTracks}"
                                      SelectedValuePath="Item1" PlaceholderText="No Audio Tracks" VerticalAlignment="Stretch"
                                      IsEnabled="{Binding Path=AudioTracks.Count, Converter={StaticResource IntToBooleanConverter}}"
                                      SelectionChanged="AudioTrackSelector_SelectionChanged" DisplayMemberPath="Item2"/>
                            <Slider x:Name="VolumeSlider" IsTabStop="False"
                                    Maximum="{Binding Player.Config.Player.VolumeMax, Mode=OneWay}"
                                    Value="{Binding Player.Audio.Volume, Mode=TwoWay}"
                                    TickFrequency="100" TickPlacement="Outside"
                                    PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                                    Width="150" Margin="8,0,0,0"/>
                            <!--<Button>
                                <FontIcon Glyph="&#xE767;" />
                            </Button>-->
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</Window>
