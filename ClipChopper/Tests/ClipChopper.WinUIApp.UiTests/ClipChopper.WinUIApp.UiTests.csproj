<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(WindowsAppTargetFramework)</TargetFramework>
    <Platforms>$(AppPlatforms)</Platforms>
    <Configurations>$(AppConfigurations)</Configurations>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" Version="$(FlaUICorePackageVersion)" />
    <PackageReference Include="FlaUI.UIA3" Version="$(FlaUIUIA3PackageVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkPackageVersion)" />
    <PackageReference Include="xunit" Version="$(XunitPackageVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds the app before the tests, without referencing its assembly. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Applications\ClipChopper.WinUIApp\ClipChopper.WinUIApp.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true"
                      SetTargetFramework="TargetFramework=$(WinUIAppTargetFramework)"
                      SetPlatform="Platform=x64"
                      AdditionalProperties="RuntimeIdentifier=win-x64" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app and the tests compile the same files, so both use the same option names, parser and range format. -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Applications\ClipChopper.WinUIApp\CommandLine\LaunchOptionNames.cs" Link="CommandLine\LaunchOptionNames.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Applications\ClipChopper.WinUIApp\CommandLine\LaunchOptions.cs" Link="CommandLine\LaunchOptions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Applications\ClipChopper.WinUIApp\CommandLine\LaunchOptionsParser.cs" Link="CommandLine\LaunchOptionsParser.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Applications\ClipChopper.WinUIApp\CommandLine\LaunchTheme.cs" Link="CommandLine\LaunchTheme.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Applications\ClipChopper.WinUIApp\Automation\RangeStatusFormat.cs" Link="Automation\RangeStatusFormat.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppExePath</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\Applications\ClipChopper.WinUIApp\bin\x64\$(Configuration)\$(WinUIAppTargetFramework)\win-x64\ClipChopper.exe'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ArtifactsDir</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\artifacts\ui-tests'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
