## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
ClipChopper/Applications/ClipChopper.WinUIApp/Installer/[Oo]utput/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Visual Studio 2017 auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Benchmark Results
BenchmarkDotNet.Artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio Trace Files
*.e2e

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# DotCover is a Code Coverage Tool
*.dotCover

# Visual Studio code coverage results
*.coverage
*.coveragexml

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if necessary however generally it will be regenerated when needed
#!**/[Pp]ackages/repositories.config
# NuGet v3's project.json files produces more ignorable files
*.nuget.props
*.nuget.targets

# Publish output (Inno Setup reads Installer/publish)
publish/

# Windows App SDK and MSIX package output
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
*.msixupload

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!?*.[Cc]ache/

# Signing certificates and publish settings
*.pfx
*.publishsettings

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# MSBuild Binary and Structured Log
*.binlog

# Local History for Visual Studio
.localhistory/

# Backup folder for Package Reference Convert tool in Visual Studio 2017
MigrationBackup/

# FFmpeg binaries are downloaded at build time by ClipChopper/Scripts/Get-FFmpeg.ps1
ClipChopper/Applications/ClipChopper.WinUIApp/FFmpeg/

# Inno Setup installers (Installer/bin and Installer/Output are covered above)
ClipChopper/Applications/ClipChopper.WinUIApp/Installer/**/*.exe

# OS-generated files
Thumbs.db
.DS_Store
desktop.ini

# =======================================================
# NEVER COMMIT .env FILE
# It may contain credentials and personal access tokens
# =======================================================
.env
.env.local
.env.*.local

# Claude Code and AI tools local configs
CLAUDE.local.md
settings.local.json
.claude/plans/
.claude/tasks/
.claude/logs/
.claude/worktrees/
.worktrees/
.mcp.json

# Get-Shit-Done (GSD) meta-prompting framework - local planning artifacts
.planning/

# Local notes and research (not for publication)
Notes/

# Local-only docs/work
docs/superpowers/
docs/private/

# feature-pipeline local artifacts (requirements.md, spec.md, test-plan.md,
# review.md, security-review.md, task-context.md, pipeline-state.json).
# Anchored to the repo root so a future nested directory named "tasks"
# (e.g. under Docs/ or Sources/) is not accidentally ignored.
/tasks/
